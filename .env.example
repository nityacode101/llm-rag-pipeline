# Get an API key from https://aistudio.google.com/apikey
# Keep this file local. Never commit a real key (.env is gitignored).
GEMINI_API_KEY=your_gemini_api_key_here

# Set true only for offline smoke tests without Gemini
DEMO_MODE=false

# Optional. If set, /query and /ingest require header: X-API-Key
APP_API_TOKEN=

# Models
GEMINI_CHAT_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# Chunking (optimized for retrieval accuracy)
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Retrieval (cosine similarity threshold)
TOP_K=3
SIMILARITY_THRESHOLD=0.15

# Server — local only so the Gemini key cannot be used from the network
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
MAX_UPLOAD_BYTES=10485760
